{
  "name": "@syncport/sdk",
  "version": "0.1.0",
  "description": "High-level Syncport client for data export and adapter registration",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@syncport/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@syncport/airtable": "workspace:*",
    "@syncport/csv": "workspace:*",
    "@syncport/hubspot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@syncport/airtable": { "optional": true },
    "@syncport/csv": { "optional": true },
    "@syncport/hubspot": { "optional": true }
  }
}
