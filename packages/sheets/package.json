{
  "name": "@syncport/sheets",
  "version": "0.1.1",
  "description": "Google Sheets row adapter for Syncport — browser-compatible JSON to sheet rows",
  "keywords": [
    "syncport",
    "google-sheets",
    "sheets",
    "spreadsheet",
    "rows",
    "json",
    "transform",
    "adapter",
    "typescript",
    "data-transform"
  ],
  "homepage": "https://syncport.vercel.app/playground",
  "bugs": "https://github.com/pakizahsaqib/syncport/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pakizahsaqib/syncport.git",
    "directory": "packages/sheets"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@syncport/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
